# Copy this file to .env. Never commit the real .env file.

# Stripe test-mode secret key. Must start with sk_test_.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional: use a recurring Stripe test Price instead of the inline price.
STRIPE_PRICE_ID=

# Stripe webhook signing secret from `stripe listen` or the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Pro price in the smallest currency unit: 900 = S$9.00 per month.
PRO_PLAN_AMOUNT_CENTS=900
PRO_PLAN_CURRENCY=sgd

# Optional LinkedIn organisation lookup access.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202601

